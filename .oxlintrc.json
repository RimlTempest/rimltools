{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/oxlint-plugin-rimltools/index.ts"],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "rimltools/no-class": "error",
    "rimltools/no-type-assertion": "error",
    "rimltools/no-enum": "error",

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-extraneous-class": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // union を網羅した switch は TS が「全経路が返る」と理解するが、この規則は
    // 理解しない。default を足すと網羅チェックが効かなくなり、拡張性の担保
    // （メンバー追加でコンパイルエラー）が壊れる。tsconfig の noImplicitReturns
    // が本当の返し忘れを検出するので、こちらは無効にする。
    "typescript/consistent-return": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",

    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-param-reassign": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/no-shadow": "error",
    "eslint/default-param-last": "error",
    "eslint/prefer-object-spread": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-array-for-each": "off",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",

    "import/no-cycle": "error",
    "import/no-default-export": "error",

    "react/react-in-jsx-scope": "off",

    // インラインハンドラやオブジェクトリテラルは React 19 では通常の書き方であり、
    // この規則を守ると useCallback / useMemo だらけになって読みにくくなる。
    // dangerouslySetInnerHTML のように毎回オブジェクトが要る API もある。
    // メモ化は計測してから入れる。
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    // JSX を prop で渡す「スロット」は React の標準的な合成パターン。
    // これを避けると、slot ごとにコンポーネントを切り出す羽目になる。
    "react-perf/jsx-no-jsx-as-prop": "off",

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      // ドメイン層（shared/contract・features/*/contract・features/*/core・packages の core）は throw しない
      "files": [
        "packages/contract/src/**/*.ts",
        "packages/*/src/core/**/*.ts",
        "apps/*/shared/contract/src/**/*.ts",
        "apps/qrcc/shared/kernel/conformance/**/*.ts",
        "apps/*/features/*/contract/**/*.ts",
        "apps/*/features/*/core/**/*.ts"
      ],
      "rules": { "rimltools/no-throw-in-domain": "error" }
    },
    {
      // Durable Object は class でしか書けない。ここだけが例外（noter ADR-0004）。
      "files": ["apps/noter/features/sync/worker/document-room.ts"],
      "rules": { "rimltools/no-class": "off" }
    },
    {
      // Worker のエントリは default export が必須
      "files": ["apps/noter/services/sync/src/index.ts", "infra/tfstate/src/index.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "eslint/no-console": "off",
        "import/no-default-export": "off",
        "rimltools/no-throw-in-domain": "off"
      }
    },
    {
      "files": [
        "tools/**/*.ts",
        "apps/*/tools/**/*.js",
        "**/*.config.ts",
        "**/*.config.js",
        "**/vite.config.ts",
        "**/*.route.tsx",
        "**/routeTree.gen.ts"
      ],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["scripts/**/*.ts", "apps/*/scripts/**/*.ts", "infra/tfstate/src/index.ts"],
      "rules": { "eslint/no-console": "off" }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    // Service Worker の生成物（scripts/build-sw.ts）
    "**/public/sw.js",
    "**/*.d.ts",
    "**/.output/**",
    "**/target/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    ".agents/**",
    ".claude/**",
    "infra/terraform/**",
    "infra/grafana/**"
  ]
}
