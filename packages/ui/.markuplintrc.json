{
  "$schema": "https://raw.githubusercontent.com/markuplint/markuplint/main/config.schema.json",
  "extends": ["markuplint:recommended-react"],
  "parser": {
    "\\.[jt]sx$": "@markuplint/jsx-parser"
  },
  "specs": {
    "\\.[jt]sx$": "@markuplint/react-spec"
  },
  "rules": {
    "require-accessible-name": true,
    "wai-aria": {
      "options": {
        "checkingValue": true,
        "checkingDeprecatedProps": true
      }
    },
    "landmark-roles": {
      "options": {
        "ignoreRoles": []
      }
    },
    "required-h1": {
      "options": {
        "expectedOnce": true,
        "inDocumentFragment": false
      }
    },
    "heading-levels": true,
    "no-refer-to-non-existent-id": true,
    "label-has-control": true,
    "use-list": true,
    "no-empty-palpable-content": true,
    "no-hard-code-id": false,
    "attr-duplication": true,
    "character-reference": false,
    "class-naming": false,
    "permitted-contents": true,
    "invalid-attr": {
      "options": {
        "disallowAttrs": ["accesskey"],
        "allowAttrs": [
          {
            "name": "tabindex",
            "value": {
              "enum": ["-1", "0"]
            }
          }
        ]
      }
    }
  },
  "nodeRules": [
    {
      "selector": ":where(html)",
      "rules": {
        "required-attr": ["lang"]
      }
    },
    {
      "selector": "img",
      "rules": {
        "required-attr": ["alt"]
      }
    },
    {
      "selector": ":where(video, audio)",
      "rules": {
        "required-element": ["track"]
      }
    }
  ],
  "excludeFiles": ["**/node_modules/**", "**/dist/**", "**/.output/**", "**/routeTree.gen.ts"],
  "overrides": {
    "./src/**/*.tsx": {
      "$comment": "コンポーネントは中身を props で受け取るため、静的解析からは常に空に見える。実際に空になっていないかは、描画後の DOM を見る e2e の axe チェックが担保する。",
      "rules": {
        "no-empty-palpable-content": false
      }
    }
  }
}
