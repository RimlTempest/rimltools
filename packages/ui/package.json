    "build": "tsc --build",
    "test": "bun test",
    "lint:html": "node ../../tools/markuplint/run.ts --config ../../.markuplintrc.json 'src/**/*.tsx'"
  },
  "dependencies": {
    "@rimltempest/riml-ds-css": "^0.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
