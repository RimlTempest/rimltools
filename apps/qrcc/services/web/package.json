{
  "name": "@qrcc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "wrangler types --env-interface CloudflareEnv ./src/worker-configuration.d.ts && tsr generate",
    "dev": "bun run sw && vite dev",
    "build": "bun run sw && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./src/worker-configuration.d.ts",
    "test": "bun test",
    "e2e": "playwright test",
    "a11y": "playwright test --grep @a11y",
    "typecheck": "bun run gen && tsc --build",
    "db:local": "wrangler d1 migrations apply qrcc --local",
    "sw": "bun ../../../../scripts/build-sw.ts src/sw/sw.ts public/sw.js"
  },
  "dependencies": {
    "@qrcc/auth": "workspace:*",
    "@qrcc/contract": "workspace:*",
    "@qrcc/generate": "workspace:*",
    "@qrcc/manage": "workspace:*",
    "@qrcc/print": "workspace:*",
    "@qrcc/scan": "workspace:*",
    "@qrcc/shell": "workspace:*",
    "@qrcc/ui": "workspace:*",
    "@qrcc/wasm": "workspace:*",
    "@rimltools/sw": "workspace:*",
    "@rimltools/telemetry": "workspace:*",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@tanstack/router-cli": "1.167.36",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  }
}
