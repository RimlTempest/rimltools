{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // tools.riml4i.com のポータル。`main` を持たない Static Assets だけの Worker にしている。
  // 静的アセットへのリクエストは無料・無制限で、Workers Free の 100k req/日 を消費しない
  // （https://developers.cloudflare.com/workers/platform/pricing/ の脚注 3）。
  "name": "rimltools-portal",
  "compatibility_date": "2026-09-14",
  // 公開は Terraform が管理する Custom Domain（tools.riml4i.com）だけ（ADR-0005）。
  // routes をここに書かない。workers.dev と preview URL も閉じる。
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
