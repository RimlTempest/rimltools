// Grafana Faro（ブラウザの RUM）の受け口。ブラウザ → faro.receiver → LGTM。
// ログは Loki の push API、trace は OTLP で LGTM の collector へ送る。
// 本番の Grafana Cloud では Faro の collector がこの役を担う。

faro.receiver "rimltools" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    // ローカルの dev サーバのオリジンだけを許可する（docs/local-dev.md）。
    // - portless の名前付き URL。worktree ではブランチ名が前に付くのでワイルドカード
    // - Google ログインを試すときの固定ポート（tools.json の fixedDevPort）と vite preview
    // 受け口は 127.0.0.1 にしか公開していない（compose.yaml）
    cors_allowed_origins = [
      "https://*.rimltools.localhost",
      "https://*.rimltools.local.riml4i.com",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
    ]
  }

  output {
    logs   = [loki.process.faro.receiver]
    traces = [otelcol.exporter.otlphttp.lgtm.input]
  }
}

// Faro のログに source="faro" を付ける（Loki は少なくとも 1 つのラベルでの絞り込みを要求する）
loki.process "faro" {
  stage.static_labels {
    values = { source = "faro" }
  }
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlphttp "lgtm" {
  client {
    endpoint = "http://lgtm:4318"
  }
}
