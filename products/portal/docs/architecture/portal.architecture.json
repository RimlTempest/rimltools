{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "portal の構成",
    "output": "portal-architecture.html",
    "quality_profile": "showcase",
    "repository": {
      "url": "https://github.com/RimlTempest/rimltools",
      "revision": "ebb4a1952c6a19f52fe3fbcfb0e2edbc68e3d56d"
    }
  },
  "components": [
    {
      "id": "registry",
      "type": "database",
      "label": "tools.json",
