      "size": [180, 64],
      "sources": [
        {
          "path": "tools.json",
          "label": "台帳"
        }
      ]
    },
    {
      "id": "build",
      "type": "backend",
      "label": "ビルド",
      "sublabel": "index.html・404.html を生成",
      "pos": [340, 120],
      "size": [180, 64],
      "sources": [
        {
          "path": "products/portal/scripts/build.ts",
          "label": "build"
        },
        {
          "path": "products/portal/src/render.ts",
          "label": "render"
        }
      ]
    },
    {
      "id": "assets",
      "type": "frontend",
      "label": "Worker: rimltools-portal",
      "sublabel": "Static Assets だけ（main なし）",
      "tag": "100k req/日 を消費しない",
      "pos": [640, 120],
      "size": [200, 64],
      "sources": [
        {
          "path": "products/portal/wrangler.jsonc",
          "label": "wrangler"
        },
        {
          "path": "products/portal/public/_headers",
          "label": "CSP・HSTS"
        }
      ]
    },
    {
      "id": "browser",
      "type": "external",
      "label": "ブラウザ",
      "sublabel": "tools.riml4i.com",
      "pos": [960, 120],
      "size": [180, 64]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "Cloudflare Workers Free",
      "wraps": ["assets"]
    }
  ],
  "connections": [
    {
      "id": "registry-build",
      "from": "registry",
      "to": "build",
      "label": "listed なツール"
    },
    {
      "id": "build-assets",
      "from": "build",
      "to": "assets",
      "label": "dist/",
      "variant": "emphasis"
    },
    {
      "id": "browser-assets",
      "from": "browser",
      "to": "assets",
      "label": "HTTPS",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "静的ファイルだけ",
      "items": [
        "script を持たないページ。Worker のコードは動かない",
        "静的アセットへのリクエストは Workers Free の枠を使わない"
      ]
    },
    {
      "dot": "cyan",
      "title": "台帳から作る",
      "items": [
        "ツールを tools.json に足すと、次のビルドで一覧に載る",
        "CSP と HSTS は _headers で付ける"
      ]
    }
  ]
}
