{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "resolveJsonModule": true
  },
  "include": ["contract/**/*", "core/**/*", "ui/**/*", "server/**/*", "fixtures/**/*.json"],
  "references": [
    {
      "path": "../../shared/contract"
    },
    {
      "path": "../../shared/ui"
    }
  ],
  "exclude": ["**/*.route.tsx", "dist"]
}
