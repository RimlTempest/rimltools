{
  "$comment": "render の要求と期待結果。Rust(qrcc-generate) は実際に生成し、TS(@qrcc/generate/contract) は同じ JSON を組み立てられることを確かめる。",
  "cases": [
    {
      "name": "qr-url-default",
      "request": {
        "payload": { "kind": "url", "url": "https://qrcc.riml4i.com" },
        "symbology": { "kind": "qr", "ec": "M" },
        "style": {
          "foreground": "#000000",
          "background": { "kind": "solid", "color": "#ffffff" },
          "scale": 4,
          "quiet_zone": null,
          "module_shape": "square",
          "bar_height": 40,
          "human_readable": true
        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "URL: https://qrcc.riml4i.com", "warnings": [] }
    },
    {
      "name": "qr-wifi-low-contrast",
      "request": {
        "payload": {
          "kind": "wifi",
          "ssid": "home",
          "auth": { "kind": "wpa", "password": "secret" },
          "hidden": false
        },
        "symbology": { "kind": "qr", "ec": "H" },
        "style": {
          "foreground": "#777777",
          "background": { "kind": "solid", "color": "#888888" },
          "scale": 2,
          "quiet_zone": 2,
          "module_shape": "dot",
          "bar_height": 40,
          "human_readable": false
        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "Wi-Fi 設定: home", "warnings": ["low_contrast"] }
    },
    {
      "name": "qr-tel",
      "request": {
        "payload": { "kind": "tel", "number": "+819012345678" },
        "symbology": { "kind": "qr", "ec": "M" },
        "style": {
          "foreground": "#000000",
          "background": { "kind": "solid", "color": "#ffffff" },
          "scale": 4,
          "quiet_zone": null,
          "module_shape": "square",
          "bar_height": 40,
          "human_readable": true
        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "電話番号: +819012345678", "warnings": [] }
    },
    {
      "name": "qr-email",
      "request": {
        "payload": {
          "kind": "email",
          "to": "someone@example.com",
          "subject": "件名",
          "body": "本文"
        },
        "symbology": { "kind": "qr", "ec": "M" },
        "style": {
          "foreground": "#000000",
          "background": { "kind": "solid", "color": "#ffffff" },
          "scale": 4,
          "quiet_zone": null,
          "module_shape": "square",
          "bar_height": 40,
          "human_readable": true
        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "メール: someone@example.com", "warnings": [] }
    },
    {
      "name": "qr-sms",
      "request": {
        "payload": { "kind": "sms", "number": "+819012345678", "body": "本文" },
        "symbology": { "kind": "qr", "ec": "M" },
        "style": {
          "foreground": "#000000",
          "background": { "kind": "solid", "color": "#ffffff" },
          "scale": 4,
          "quiet_zone": null,
          "module_shape": "square",
          "bar_height": 40,
          "human_readable": true
        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "SMS: +819012345678", "warnings": [] }
    },
    {
      "name": "qr-geo",
      "request": {
        "payload": { "kind": "geo", "lat": 35.681236, "lon": 139.767125 },
        "symbology": { "kind": "qr", "ec": "M" },
        "style": {
          "foreground": "#000000",
          "background": { "kind": "solid", "color": "#ffffff" },
          "scale": 4,
          "quiet_zone": null,
