        },
        "output": "svg"
      },
      "expect": { "ok": true, "description": "位置情報: 35.681236, 139.767125", "warnings": [] }
    },
    {
      "name": "qr-event",
      "request": {
        "payload": {
          "kind": "event",
          "event": {
            "subject": "定例会議",
            "start": "2026-09-06T10:00",
