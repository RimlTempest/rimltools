{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qrcc-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 入口はカスタムドメインだけにする。workers.dev を開けると APP_ORIGIN と
  // 違うオリジンが増え、Cookie も OAuth のリダイレクト先も噛み合わなくなる。
  "workers_dev": false,
  // Custom Domain（qrcc.tools.riml4i.com）は Terraform の持ち物（ルート ADR-0005）。
  // wrangler の routes に書くと versions deploy とは別経路で更新され、Terraform と取り合いになる。
  // 環境ごとのホスト名と APP_ORIGIN は scripts/release が書き換えて出す（docs/release.md）。

  // qrcc-api は routes を持たない auxiliary Worker。ここからのみ到達できる。
  "services": [{ "binding": "API", "service": "qrcc-api" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrcc",
      "database_id": "69c356fa-5d2f-4bfc-aa62-c528d1a73dcf",
      "migrations_dir": "../api/migrations",
    },
  ],

  "vars": { "APP_ORIGIN": "https://qrcc.riml4i.com" },
  // BETTER_AUTH_SECRET / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET は
  // wrangler secret put で設定する。.dev.vars はコミットしない。
}
