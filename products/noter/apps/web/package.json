{
  "name": "@noter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "wrangler types --env-interface CloudflareEnv ./src/worker-configuration.d.ts && tsr generate",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./src/worker-configuration.d.ts",
    "test": "bun test",
    "e2e": "playwright test",
    "a11y": "playwright test --grep @a11y",
    "typecheck": "bun run gen && tsc --build",
    "db:local": "wrangler d1 migrations apply noter --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@noter/auth": "workspace:*",
    "@noter/contract": "workspace:*",
    "@noter/documents": "workspace:*",
    "@noter/editor": "workspace:*",
    "@noter/formats": "workspace:*",
    "@noter/shell": "workspace:*",
    "@noter/sync": "workspace:*",
    "@noter/ui": "workspace:*",
    "@noter/webmcp": "workspace:*",
    "@rimltools/telemetry": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.3",
    "dompurify": "3.4.14",
    "drizzle-orm": "0.45.2",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.1",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  }
