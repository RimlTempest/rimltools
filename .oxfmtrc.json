{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "experimentalOperatorPosition": "start",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.output/**",
    "**/target/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "**/*.gen.ts",
    "infra/**/.terraform/**",
    ".agents/skills/**",
    ".claude/skills/**",
    "skills-lock.json",
    "products/*/.agents/skills/**",
    "products/*/.claude/skills/**",
    "products/*/docs/architecture/*.html",
    "infra/secrets/*.sops.yaml",
    "scripts/lib/fixtures/**"
  ]
}
