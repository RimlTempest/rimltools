{
  "$schema": "https://raw.githubusercontent.com/markuplint/markuplint/main/config.schema.json",
  "$comment": "markuplint の設定はリポジトリで 1 つ（products と packages が --config で参照する）。overrideMode は既定の reset だと、overrides に一致したファイルで parser 設定ごと消えて .tsx が検査されなくなるので merge にする（tools/markuplint/run.ts）。 video の track 必須は音のある video だけに掛ける（字幕 WCAG 1.2.2 は音声のある媒体が対象。muted のカメラプレビューに空の track を足すのは見せかけになる）。",
  "overrideMode": "merge",
  "extends": ["markuplint:recommended-react"],
  "parser": {
    "\\.[jt]sx$": "@markuplint/jsx-parser"
  },
  "specs": {
    "\\.[jt]sx$": "@markuplint/react-spec"
  },
  "rules": {
    "require-accessible-name": true,
    "wai-aria": {
      "options": {
        "checkingValue": true,
        "checkingDeprecatedProps": true
      }
    },
    "landmark-roles": {
      "options": {
        "ignoreRoles": []
      }
    },
    "required-h1": {
      "options": {
        "expectedOnce": true,
        "inDocumentFragment": false
      }
    },
    "heading-levels": true,
    "no-refer-to-non-existent-id": true,
    "label-has-control": true,
    "use-list": true,
    "no-empty-palpable-content": true,
    "no-hard-code-id": false,
    "attr-duplication": true,
    "character-reference": false,
    "class-naming": false,
    "permitted-contents": true,
    "invalid-attr": {
      "options": {
        "disallowAttrs": ["accesskey"],
        "allowAttrs": [
          {
            "name": "tabindex",
            "value": {
              "enum": ["-1", "0"]
            }
          }
        ]
      }
    }
  },
  "nodeRules": [
    {
      "selector": ":where(html)",
      "rules": {
        "required-attr": ["lang"]
      }
    },
    {
      "selector": "img",
      "rules": {
        "required-attr": ["alt"]
      }
    },
    {
      "selector": ":where(video, audio)",
      "rules": {
        "required-element": ["track"]
      }
    },
    {
      "selector": "video[muted]",
      "rules": {
        "required-element": false
      }
    }
  ],
  "excludeFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/routeTree.gen.ts",
    "**/docs/architecture/*.html"
  ],
  "overrides": {
    "./{products/*/shared/ui/src,products/*/features/*/ui,packages/*/src}/**/*.tsx": {
      "$comment": "コンポーネントは中身を props で受け取るため、静的解析からは常に空に見える。実際に空になっていないかは、描画後の DOM を見る e2e の axe チェックが担保する。",
      "rules": {
        "no-empty-palpable-content": false
      }
    }
  }
}
