{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // OpenTofu の state 置き場（docs/adr/0009-state-and-secrets.md）。
  // state を管理する仕組み自身を state で管理すると鶏と卵になるので、この Worker だけは
  // Terraform / OpenTofu ではなく wrangler で直接デプロイする（README のブートストラップ）。
  "name": "rimltools-tfstate",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  // 公開は Custom Domain だけ。workers.dev と preview URL は閉じる（資格情報付きでも入口を増やさない）
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tfstate.tools.riml4i.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rimltools-tfstate",
      // `wrangler d1 create rimltools-tfstate` の出力で置き換える（README §1）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // secret（wrangler secret put）: READ_USER / READ_PASSWORD / WRITE_USER / WRITE_PASSWORD
}
